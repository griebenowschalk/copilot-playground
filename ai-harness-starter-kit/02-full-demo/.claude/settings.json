{
  "permissions": {
    "allow": ["Bash(pnpm *)", "Bash(git *)", "Bash(bash .claude/skills/**)", "Read(*)", "Edit(*)"],
    "deny": ["Bash(rm -rf *)", "Read(./.env)", "Read(./.env.*)"]
  },
  "hooks": {
    "PostToolUse": [
      { "matcher": "Edit|Write", "command": "pnpm lint --fix --quiet || true" }
    ]
  }
}
